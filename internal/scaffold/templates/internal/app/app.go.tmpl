// Package app assembles dependencies and manages the application lifecycle.
package app

import (
	"context"
	"errors"
	"fmt"
	"log/slog"

	"go.uber.org/fx"
	"go.uber.org/fx/fxevent"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/health"
	"{{.Module}}/internal/httpserver"
	"{{.Module}}/internal/user"
)

// Run starts this application's dependencies and waits for cancellation,
// SIGINT, SIGTERM, or an internal shutdown request.
func Run(ctx context.Context, cfg *config.Config, logger *slog.Logger) error {
	application := fx.New(
		fx.Supply(cfg, logger),
		fx.WithLogger(func(logger *slog.Logger) fxevent.Logger {
			events := &fxevent.SlogLogger{Logger: logger.With("component", "fx")}
			events.UseLogLevel(slog.LevelDebug)
			return events
		}),
		httpserver.Module,
		health.Module,
		user.Module,
	)
	if err := application.Err(); err != nil {
		return err
	}
	done := application.Wait()
	startCtx, cancelStart := context.WithTimeout(ctx, application.StartTimeout())
	err := application.Start(startCtx)
	cancelStart()
	if err != nil {
		return err
	}

	var runErr error
	select {
	case signal := <-done:
		if signal.ExitCode != 0 {
			runErr = fmt.Errorf("application requested shutdown with exit code %d", signal.ExitCode)
		}
	case <-ctx.Done():
		runErr = ctx.Err()
	}

	// Shutdown gets a fresh deadline even if the command context was canceled.
	stopCtx, cancelStop := context.WithTimeout(context.Background(), application.StopTimeout())
	defer cancelStop()
	return errors.Join(runErr, application.Stop(stopCtx))
}
