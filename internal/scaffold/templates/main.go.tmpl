package main

import (
	"log/slog"
	"os"

	"github.com/TTWShell/zodiac-core/logging"

	"{{.Module}}/cmd"
)

func main() {
	logger := logging.New("{{.Name}}", slog.LevelInfo)
	slog.SetDefault(logger)

	if err := cmd.Execute(); err != nil {
		logger.Error("Command failed", "error", err)
		os.Exit(1)
	}
}
